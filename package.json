{
  "name": "telegram-tc",
  "version": "1.21.2",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "test": "bun test",
    "test:backend": "bun test packages/core apps/api",
    "test:frontend": "bun test apps/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun run build:api && bun run build:web",
    "build:api": "bun build apps/api/src/server.ts --target=bun --outdir dist/api --external telegram --external telegram/sessions --external websocket --external bufferutil --external utf-8-validate",
    "build:web": "bun run --cwd apps/web build",
    "docker:build": "docker build -t telegram-tc:local .",
    "deploy": "bash scripts/deploy.sh",
    "telegram:start": "bun scripts/telegram-flow.ts start",
    "telegram:dialogs": "bun scripts/telegram-flow.ts dialogs",
    "telegram:select": "bun scripts/telegram-flow.ts select",
    "telegram:import": "bun scripts/telegram-flow.ts import",
    "telegram:backtest": "bun scripts/telegram-flow.ts backtest",
    "mt5:smoke": "bun scripts/mt5-smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@vitejs/plugin-react": "^5.1.1",
    "hono": "^4.10.7",
    "lucide-react": "^0.561.0",
    "nanoid": "^5.1.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.15.1",
    "telegram": "^2.26.22",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.9",
    "@happy-dom/global-registrator": "^20.0.10",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "4",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
